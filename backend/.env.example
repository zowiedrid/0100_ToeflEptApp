PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=toefl_ept_super_secret_jwt_key_0100
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=toefl_ept_refresh_token_secret_key_0100
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (MySQL / Postgres / SQLite)
# Untuk MySQL: set DB_DIALECT=mysql, DB_PORT=3306
# Untuk Postgres: set DB_DIALECT=postgres, DB_PORT=5432
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=toefl_ept_db
DB_USER=root
DB_PASS=
